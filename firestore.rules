rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /promptie_templates/{id} {
      allow read, write: if request.auth != null;
    }
    match /promptie_companies/{id} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    match /promptie_meta/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
